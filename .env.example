# ==============================================================================
# Infosys Springboard — Meeting Intelligence Platform Configuration
# ==============================================================================

# Server configuration
PORT=5000
FLASK_ENV=production

# Speech-to-Text (Whisper) configuration
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL=tiny

# LLM Intelligence Service configuration
# Provider options: openai, gemini, mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=3
LLM_CHUNK_CHARS=12000
LLM_CHUNK_OVERLAP=500

# API Keys (Never commit actual keys)
OPENAI_API_KEY=your_openai_api_key_here
LLM_API_KEY=your_api_key_here

# Database path (default: meeting_intelligence.db in project root)
DATABASE_PATH=meeting_intelligence.db